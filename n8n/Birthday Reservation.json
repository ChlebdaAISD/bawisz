addon ? ('<div style=\"margin-top: 22px; padding: 18px 20px; background-color: #FDF9F0; border-radius: 14px; border: 1px solid rgba(168,128,98,0.16);\"><p style=\"margin: 0 0 6px; font-family: \\'Fraunces\\', Georgia, serif; font-size: 18px; font-weight: 700; color: #776258;\">+ Pakiet dla rodziców</p><p style=\"margin: 0 0 12px; font-size: 14px; color: #776258;\">na czas urodzin · ' + $json.body.parents_price_per_person + ' zł/osoba × ' + $json.body.parents_count + ' = ' + $json.body.parents_cost + ' zł</p><ul style=\"margin: 0; padding: 0 0 0 18px; color: #5C4F47;\">' + (($json.body.parents_snacks || []).concat($json.body.parents_decor || [])).map(s => '<li style=\"font-size: 14px; line-height: 1.55; margin-bottom: 4px;\">' + s + '</li>').join('') + '</ul></div>') : '' }}\n                                        <div style=\"border-top: 1px dashed rgba(168,128,98,0.32); margin: 22px 0 16px;\"></div>\n                                        <p style=\"margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #9E8C7E;\">Szacunkowy koszt</p>\n                                        <p style=\"margin: 6px 0 6px; font-family: 'Fraunces', Georgia, serif; font-size: 30px; font-weight: 700; color: #9DB585; line-height: 1;\">ok. {{$json.body.total_estimated}} zł</p>\n                                        <p style=\"margin: 8px 0 0; font-size: 12px; line-height: 1.5; color: #9E8C7E;\">Wycena może się minimalnie różnić w zależności od finalnej liczby gości.</p>\n                                    </td>\n                                </tr>\n                            </table>\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #FFFFFF; border: 1px solid rgba(168,128,98,0.16); border-radius: 18px; margin: 0 0 28px;\">\n                                <tr>\n                                    <td style=\"padding: 22px 26px;\">\n                                        <p style=\"margin