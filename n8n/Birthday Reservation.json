\n                    <tr>\n                        <td class=\"mobile-padding\" style=\"padding: 48px 48px 32px;\">\n                            <h2 class=\"mobile-heading\" style=\"font-family: 'Fraunces', Georgia, serif; font-size: 32px; font-weight: 600; color: #5C4F47; margin: 0 0 24px; line-height: 1.15; letter-spacing: -0.01em;\">\n                                Dziękujemy za zapytanie\n                            </h2>\n                            <p class=\"mobile-text\" style=\"font-size: 16px; line-height: 1.65; color: #776258; margin: 0 0 18px;\">\n                                Cześć {{$json.body.client_name}}, otrzymaliśmy Twoją prośbę o rezerwację urodzin w Bawisz. <strong style=\"color: #5C4F47;\">Poniżej znajduje się podsumowanie tego, co wpisałeś/aś w formularzu — to jeszcze nie jest potwierdzona rezerwacja.</strong> Odezwiemy się do Ciebie w ciągu 24 godzin, żeby potwierdzić dostępność terminu i ustalić szczegóły.\n                            </p>\n                            <p class=\"mobile-text\" style=\"font-size: 16px; line-height: 1.65; color: #776258; margin: 0 0 30px;\">\n                                Jeśli coś jest nie tak w podsumowaniu albo chcesz coś zmienić — zadzwoń do nas, najszybciej wszystko ustalimy przez telefon.\n                            </p>\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #F4EBDB; border-radius: 18px; margin: 0 0 28px;\">\n                                <tr>\n                                    <td style=\"padding: 28px 30px;\">\n                                        <p style=\"margin: 0 0 18px; font-family: 'Cabin', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #A98062;\">\n                                            Podsumowanie Twojego zapytania\n                                        </p>\n                                        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                                            <tr>\n                                                <td style=\"padding-bottom: 14px;\">\n                                                    <p style=\"margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #9E8C7E;\">Urodziny</p>\n                                                    <p style=\"margin: 4px 0 0; font-family: 'Fraunces', Georgia, serif; font-size: 18px; font-weight: 600; color: #5C4F47;\">{{$json.body.child_age}}-latka/-latki</p>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding-bottom: 14px;\">\n                                                    <p style=\"margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #9E8C7E;\">Data</p>\n                                                    <p style=\"margin: 4px 0 0; font-family: 'Fraunces', Georgia, serif; font-size: 18px; font-weight: 600; color: #5C4F47;\">{{$json.body.event_date}}</p>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding-bottom: 14px;\">\n                                                    <p style=\"margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #9E8C7E;\">Liczba dzieci (przybliżona)</p>\n                                                    <p style=\"margin: 4px 0 0; font-family: 'Fraunces', Georgia, serif; font-size: 18px; font-weight: 600; color: #5C4F47;\">{{$json.body.children_count}}</p>\n                                                </td>\n                                            </tr>\n                                        </table>\n                                        <div style=\"border-top: 1px dashed rgba(168,128,98,0.32); margin: 18px 0;\"></div>\n                                        <p style=\"margin: 0 0 6px; font-family: 'Fraunces', Georgia, serif; font-size: 22px; font-weight: 700; color: #776258;\">Pakiet {{$json.body.package_name}}</p>\n                                        <p style=\"margin: 0 0 14px; font-size: 14px; color: #776258;\">{{$json.body.package_duration}} · {{$json.body.package_price_per_child}} zł/dziecko × {{$json.body.children_count}}</p>\n                                        <p style=\"margin: 0 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #9E8C7E;\">W pakiecie</p>\n                                        <ul style=\"margin: 0 0 0; padding: 0 0 0 18px; color: #5C4F47;\">\n                                            {{ ((($json.body.package_perks || []).concat($json.body.package_snacks || [])).concat($json.body.package_decor || [])).map(s => '<li style=\"font-size: 15px; line-height: 1.55; margin-bottom: 4px;\">' + s + '</li>').join('') }}\n                                        </ul>\n                                        {{ $json.body.parents_addon ? ('<div style=\"margin-top: 22px; padding: 18px 20px; background-color: #FDF9F0; border-radius: 14px; border: 1px solid rgba(168,128,98,0.16);\"><p style=\"margin: 0 0 6px; font-family: \\'Fraunces\\', Georgia, serif; font-size: 18px; font-weight: 700; color: #776258;\">+ Pakiet dla rodziców</p><p style=\"margin: 0 0 12px; font-size: 14px; color: #776258;\">na czas urodzin · ' + $json.body.parents_price_per_person + ' zł/osoba × ' + $json.body.parents_count + '</p><ul style=\"margin: 0; padding: 0 0 0 18px; color: #5C4F47;\">' + (($json.body.parents_snacks || []).concat($json.body.parents_decor || [])).map(s => '<li style=\"font-size: 14px; line-height: 1.55; margin-bottom: 4px;\">' + s + '</li>').join('') + '</ul></div>') : '' }}\n                                        <div style=\"border-top: 1px dashed rgba(168,128,98,0.32); margin: 22px 0 16px;\"></div>\n                                        <p style=\"margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: #9E8C7E;\">Szacunkowy koszt</p>\n                                        <p style=\"margin: 6px 0 6px; font-family: 'Fraunces', Georgia, serif; font-size: 30px; font-weight: 700; color: #9DB585; line-height: 1;\">ok. {{$json.body.total_estimated}} zł</p>\n                                        <p style=\"margin: 8px 0 0; font-size: 12px; line-height: 1.5; color: #9E8C7E;\">Końcowa wycena może się minimalnie różnić w zależności od ostatecznej liczby gości.</p>\n                                    </td>\n                                </tr>\n                            </table>\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #FFFFFF; border-left: 3px solid #A98062; border-radius: 4px; margin: 0 0 28px;\">\n                                <tr>\n                                    <td style=\"padding: 18px 22px;\">\n                                        <p style=\"font-size: 14px; line-height: 1.6; color: #776258; margin: 0;\">\n                                            <strong style=\"color: #5C4F47;\">Pilne pytania?</strong><br>\n                                            Zadzwoń: <a href=\"tel:{{$json.body.company_phone}}\" style=\"color: #A98062; text-decoration: none; border-bottom: 1px solid rgba(168,128,98,0.4);\">{{$json.body.company_phone}}</a><br>\n                                            Email: <a href=\"mailto:{{$json.body.company_email}}\" style=\"color: #A98062; text-decoration: none; border-bottom: 1px solid rgba(168,128,98,0.4);\">{{$json.body.company_email}}</a>\n                                        </p>\n                                    </td>\n                                </tr>\n                            </table>\n                            <p class=\"mobile-text\" style=\"font-size: 16px; line-height: 1.65; color: #776258; margin: 0 0 6px;\">\n                                Pozdrawiamy serdecznie,\n                            </p>\n                            <p class=\"mobile-text\" style=\"font-family: 'Fraunces', Georgia, serif; font-size: 18px; line-height: 1.6; color: #5C4F47; font-weight: 600; margin: 0;\">\n                                Zespół Bawisz\n                            </p>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td class=\"mobile-padding\" style=\"padding: 36px 48px; background-color: #F4EBDB;\">\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 22px;\">\n                                <tr>\n                                    <td>\n                                        <p style=\"margin: 0 0 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #9E8C7E;\">\n                                            Kontakt\n                                        </p>\n                                        <p style=\"margin: 0 0 6px; font-family: 'Fraunces', Georgia, serif; font-size: 16px; line-height: 1.55; color: #5C4F47; font-weight: 700;\">\n                                            {{$json.body.company_name}}\n                                        </p>\n                                        <p style=\"margin: 0 0 4px; font-size: 14px; line-height: 1.55; color: #776258;\">\n                                            {{$json.body.company_address}}\n                                        </p>\n                                        <p style=\"margin: 0 0 4px; font-size: 14px; line-height: 1.55; color: #776258;\">\n                                            Tel: <a href=\"tel:{{$json.body.company_phone}}\" style=\"color: #776258; text-decoration: none;\">{{$json.body.company_phone}}</a>\n                                        </p>\n                                        <p style=\"margin: 0 0 4px; font-size: 14px; line-height: 1.55; color: #776258;\">\n                                            Email: <a href=\"mailto:{{$json.body.company_email}}\" style=\"color: #776258; text-decoration: none;\">{{$json.body.company_email}}</a>\n                                        </p>\n                                        <p style=\"margin: 0; font-size: 14px; line-height: 1.55; color: #776258;\">\n                                            {{$json.body.company_hours}}\n                                        </p>\n                                    </td>\n                                </tr>\n                            </table>\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 22px;\">\n                                <tr>\n                                    <td>\n                                        <p style=\"margin: 0 0 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #9E8C7E;\">\n                                            Znajdziesz nas też tutaj\n                                        </p>\n                                        <table cellpadding=\"0\" cellspacing=\"0\">\n                                            <tr>\n                                                <td style=\"padding-right: 18px;\">\n                                                    <a href=\"{{$json.body.company_instagram}}\" style=\"color: #A98062; text-decoration: none; font-size: 14px; font-weight: 600;\">Instagram</a>\n                                                </td>\n                                                <td style=\"padding-right: 18px;\">\n                                                    <a href=\"{{$json.body.company_facebook}}\" style=\"color: #A98062; text-decoration: none; font-size: 14px; font-weight: 600;\">Facebook</a>\n                                                </td>\n                                                <td>\n                                                    <a href=\"{{$json.body.company_tiktok}}\" style=\"color: #A98062; text-decoration: none; font-size: 14px; font-weight: 600;\">TikTok</a>\n                                                </td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                                <tr>\n                                    <td style=\"padding-top: 18px; border-top: 1px solid rgba(168,128,98,0.16);\">\n                                        <p style=\"margin: 0; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #9E8C7E;\">\n                                            &copy; {{ $now.format('yyyy') }} {{$json.body.company_name}}\n                                        </p>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>",
